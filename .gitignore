__pycache__/
*.pyc
.venv/
venv/

# Runtime data: cache, logs, SQLite DB, secrets. data/samples/ is the
# exception -- curated reference samples (spec 11's "hit it once, save the
# response" rule) doubling as test fixtures, so they're tracked. Files
# prefixed "_" under samples/ are throwaway exploration dumps, not fixtures.
data/*
!data/samples/
data/samples/_*
# Runtime-overwritten on every successful builds-search decode, not a fixture.
data/samples/last_good_builds.bin
data/samples/last_good_builds_poe1.bin
# every runtime last_good_* capture (dev-machine runs of the fetchers write them; the builds ones hold real players' names)
data/samples/last_good_*

*.log
.env
service-account*.json

.claude/settings.local.json

# Local-only incident evidence (2026-10-15 VM outage): journal extracts hold
# third-party IPs from SSH scans; never commit.
logs/
